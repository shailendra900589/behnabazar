APP_NAME="Behna Bazar"
APP_ENV=local
APP_KEY=
# Production (Hostinger): set APP_DEBUG=false so users see friendly error pages, not code traces.
APP_DEBUG=true
APP_URL=http://localhost

# SEO / GEO (optional — also configurable in Admin → Program settings)
SEO_ENABLED=true
SEO_LOCALITY=India
SEO_REGION=IN
SEO_LATITUDE=28.6139
SEO_LONGITUDE=77.2090
# Live server: set to your full site URL (e.g. https://behnabazar.in) so CSS/JS paths load correctly.
# ASSET_URL=

# Hostinger split setup: CSS/JS in domains/.../public_html, Laravel in ~/behnabazar
# PUBLIC_HTML_PATH=/home/u991240931/domains/behnabazar.in/public_html
# BB_LARAVEL_ROOT=/home/u991240931/behnabazar

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite (recommended for local XAMPP when MySQL has issues)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# MySQL (production / XAMPP)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=behna_bazar
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@behnabazar.in
MAIL_PASSWORD=your-email-account-password
MAIL_FROM_ADDRESS="noreply@behnabazar.in"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO_ADDRESS="noreply@behnabazar.in"
MAIL_REPLY_TO_NAME="${APP_NAME}"
MAIL_SUPPORT_ADDRESS="noreply@behnabazar.in"

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Marketplace (also in Admin → Program settings)
# COD, free shipping ₹499, delivery PINs — seeded via: php artisan marketplace:setup

# SMS (log = dev; msg91 or twilio for production)
SMS_ENABLED=false
SMS_DRIVER=log
SMS_DEFAULT_COUNTRY_CODE=91
MSG91_AUTH_KEY=
MSG91_SENDER=BBAZAR
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# WhatsApp — auto picks: Meta Cloud (full auto) → CallMeBot → Outbox jugad
WHATSAPP_ENABLED=true
WHATSAPP_DRIVER=auto
WHATSAPP_BUSINESS_PHONE=9876543210
WHATSAPP_ADMIN_PHONE=9876543210
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=
WHATSAPP_CLOUD_API_VERSION=v21.0
WHATSAPP_CLOUD_TEMPLATE=
WHATSAPP_CALLMEBOT_API_KEY=
WHATSAPP_WEBHOOK_URL=

# Scheduled reminders (requires cron: * * * * * php artisan schedule:run)
ABANDONED_CART_ENABLED=true
ABANDONED_CART_IDLE_HOURS=24
ABANDONED_CART_COOLDOWN_HOURS=72
STOCK_ALERT_ENABLED=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
