# Copy to .env on live server (behnabazar.in) — do not commit real passwords to GitHub
APP_NAME="Behna Bazar"
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_FROM_OLD_ENV
APP_DEBUG=false
APP_URL=https://behnabazar.in

SEO_ENABLED=true
SEO_LOCALITY=India
SEO_REGION=IN
SEO_LATITUDE=28.6139
SEO_LONGITUDE=77.2090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u991240931_behnabazar
DB_USERNAME=u991240931_admin
DB_PASSWORD=YOUR_DB_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=ssg.bahna@gmail.com
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD
MAIL_FROM_ADDRESS="ssg.bahna@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO_ADDRESS="ssg.bahna@gmail.com"
MAIL_REPLY_TO_NAME="${APP_NAME}"
MAIL_SUPPORT_ADDRESS="ssg.bahna@gmail.com"

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

SMS_ENABLED=true
SMS_DRIVER=log
SMS_DEFAULT_COUNTRY_CODE=91
WHATSAPP_ENABLED=true
WHATSAPP_DRIVER=auto
WHATSAPP_BUSINESS_PHONE=
WHATSAPP_ADMIN_PHONE=

ABANDONED_CART_ENABLED=true
ABANDONED_CART_IDLE_HOURS=24
ABANDONED_CART_COOLDOWN_HOURS=72
STOCK_ALERT_ENABLED=true

VITE_APP_NAME="${APP_NAME}"

# Hostinger: CSS/JS folder separate from Laravel (run: php artisan hostinger:sync-public)
PUBLIC_HTML_PATH=/home/u991240931/domains/behnabazar.in/public_html
BB_LARAVEL_ROOT=/home/u991240931/behnabazar
